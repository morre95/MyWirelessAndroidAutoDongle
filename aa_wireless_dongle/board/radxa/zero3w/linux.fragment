# Radxa ZERO 3W additions to the upstream ARM64 defconfig and board/common/kernel.config

# USB accessory gadget, built in: the image has no hotplug module loading
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_HID=y

# Wi-Fi and microSD/SDIO
CONFIG_CFG80211=m
CONFIG_MMC=y

# Bluetooth over UART1: LE for the advertisement, RFCOMM for the AA and HSP profiles
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y

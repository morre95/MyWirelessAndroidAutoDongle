From: MyWirelessAndroidAutoDongle contributors
Subject: [PATCH] arm64: dts: add ZERO 3W V1.12M AIC source-check variant

Keep the generic upstream board unchanged. Describe the owner's no-eMMC
variant using the antenna and SDIO settings from the audited vendor AIC
reference. The antenna GPIO/polarity matches the running diagnostic DT.
Use the standard fixed-regulator active-low default, not the vendor's
undocumented enable-active-low property.

Retain the upstream conservative SDIO power delays. Bluetooth reset/wake
handling and physical boot/radio operation remain separate prerequisites.
This is a build-only candidate, not a supported board declaration.

Sources:
https://github.com/radxa/kernel/blob/fd366906451692033f1ba273e77e7e2f936c78db/arch/arm64/boot/dts/rockchip/rk3566-radxa-zero-3w-aic8800ds2.dts
https://github.com/gregkh/linux/blob/85d82e0d7c2dfd3e75d34f35b7ebbf41f45c9c4e/Documentation/devicetree/bindings/regulator/fixed-regulator.yaml
---
diff --git a/arch/arm64/boot/dts/rockchip/Makefile b/arch/arm64/boot/dts/rockchip/Makefile
--- a/arch/arm64/boot/dts/rockchip/Makefile
+++ b/arch/arm64/boot/dts/rockchip/Makefile
@@ -99,6 +99,7 @@
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-radxa-cm3-io.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-radxa-zero-3e.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-radxa-zero-3w.dtb
+dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-radxa-zero-3w-aic8800d80.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-roc-pc.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-rock-3c.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-soquartz-blade.dtb
diff --git a/arch/arm64/boot/dts/rockchip/rk3566-radxa-zero-3w-aic8800d80.dts b/arch/arm64/boot/dts/rockchip/rk3566-radxa-zero-3w-aic8800d80.dts
new file mode 100644
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3566-radxa-zero-3w-aic8800d80.dts
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+
+#include "rk3566-radxa-zero-3w.dts"
+
+/ {
+	model = "Radxa ZERO 3W V1.12M (AIC8800D80, no eMMC)";
+
+	regulator-board-antenna {
+		compatible = "regulator-fixed";
+		regulator-name = "board_antenna";
+		gpio = <&gpio3 RK_PD3 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&aic_antenna_enable>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+};
+
+&pinctrl {
+	antenna {
+		aic_antenna_enable: antenna-enable {
+			rockchip,pins = <3 RK_PD3 RK_FUNC_GPIO &pcfg_pull_down>;
+		};
+	};
+};
+
+&sdhci {
+	status = "disabled";
+};
+
+&sdio_pwrseq {
+	/* The AIC reference does not request the RK817 external clock. */
+	/delete-property/ clocks;
+	/delete-property/ clock-names;
+};
+
+&sdmmc1 {
+	rockchip,default-sample-phase = <180>;
+};
+
+&sdmmc1_bus4 {
+	rockchip,pins = <2 RK_PA3 1 &pcfg_pull_up_drv_level_12>,
+		       <2 RK_PA4 1 &pcfg_pull_up_drv_level_12>,
+		       <2 RK_PA5 1 &pcfg_pull_up_drv_level_12>,
+		       <2 RK_PA6 1 &pcfg_pull_up_drv_level_12>;
+};
+
+&sdmmc1_clk {
+	rockchip,pins = <2 RK_PB0 1 &pcfg_pull_up_drv_level_12>;
+};
+
+&sdmmc1_cmd {
+	rockchip,pins = <2 RK_PA7 1 &pcfg_pull_up_drv_level_12>;
+};
